# The Korp frontend of one language: korp-vue (Språkbanken's Vue 3 frontend)
# with our instance code (korp-vue-instance/) and the language's settings
# (gtweb2_config/front/config-<lang>.yaml). The result is only the built static
# site, served by the language's Worker (manage/worker/) as static assets.
#
# Build (`build front <lang>` and `deploy <lang>` in the manage tool do this),
# from the korp repo root, which is the build context (see .dockerignore there):
#
#   docker build --build-arg lang=fkv --output type=local,dest=<dir> \
#       -f manage/containerfiles/Containerfile.frontend .
#
# KORP_VUE_COMMIT below pins korp-vue: branch api-v9 for now (the Korp 9 API,
# what Språkbanken's own Korp runs against ws/korp/v9), 2026-11-11. Update it
# together with KORP_BACKEND_COMMIT in Containerfile.backend.

FROM docker.io/library/node:24-trixie-slim AS build
RUN apt-get update && apt-get install --no-install-recommends -y git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG KORP_VUE_COMMIT=a51086587009acf13c44f9337d90545756e9250f
WORKDIR /korp-vue
RUN git init -q && \
    git remote add origin https://github.com/spraakbanken/korp-vue.git && \
    git fetch -q --depth 1 origin "$KORP_VUE_COMMIT" && \
    git checkout -q FETCH_HEAD
# korp-vue's .npmrc has ignore-scripts=true: no install scripts are run
RUN npm ci --no-audit --no-fund

# Instance code (the same for all languages), then the language's settings.
# Before these, so all languages share the cached layers above.
COPY korp-vue-instance/ instance/
ARG lang
COPY gtweb2_config/front/config-${lang}.yaml instance/config.yml

# BASE=./ makes asset URLs relative, so the site works at any path (the
# Worker's root, or behind a reverse proxy at some /path/)
RUN BASE=./ npx vite build

FROM scratch
COPY --from=build /korp-vue/dist /

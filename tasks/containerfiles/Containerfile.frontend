FROM korp-frontend-base AS builder

ARG instance

COPY ./gtweb2_config/front/config-${instance}.yaml /korp/korp-frontend/app/config.yml
RUN mkdir -p /korp/korp-frontend/app/modes

# yarn build failed on this file not being present, with "invalid syntax",
# because some file did a require() on this, which some earlier part of the
# build process replaced with some non-js text about the file not being
# found.
RUN touch /korp/korp-frontend/app/modes/default_mode.js
WORKDIR /korp/korp-frontend

# 'yarn build' fails with 'Module not found: Error: Can't resolve 'custom' in '/korp/korp-frontend/app/scripts/auth'.
# Workaround: Create this module, which must be app/custom/init.ts
# and fill it with an 'stub' auth module that does nothing, like the dummyAuth in
# app/scripts/auth/init.ts
# RUN mkdir /korp/korp-frontend/app/custom
# COPY <<EOF /korp/korp-frontend/app/custom/init.ts
# const dummyAuth = {
#     init: () => false,
#     initAngular: () => {},
#     login: () => {},
#     logout: () => {},
#     getAuthorizationHeader: () => ({}),
#     hasCredential: () => false,
#     getCredentials: () => [],
#     getUsername: () => "",
#     isLoggedIn: () => false,
# }
# EOF

RUN yarn build


FROM docker.io/library/nginx

# Workaround for https://github.com/containers/buildah/issues/6048
ARG Dollar=$

COPY --from=builder /korp/korp-frontend/dist /usr/share/nginx/html/

